{
  "manifest_version": 3,
  "name": "Operation ID — скопировать список",
  "version": "2.0.3",
  "description": "Копирует operation_id и показывает результат SELECT из PostgreSQL через локальный сервис.",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite",
    "storage"
  ],
  "action": {
    "default_title": "Скопировать operation_id",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
